# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_APP_NAME="Galaxy Frog"
FASTAPI_BASE_URL=http://localhost:8000

# Local PostgreSQL (introduced in Phase 0 Step 3)
POSTGRES_DB=galaxy_frog
POSTGRES_USER=galaxy_frog
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://galaxy_frog:change-me-for-local-development@localhost:5432/galaxy_frog

# Local Phase 1 AI providers (install and run Ollama/models manually)
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_REVISION=ollama
GENERATION_MODEL=qwen3:4b

# Durable ingestion worker (worker id defaults to hostname-process-id)
# INGESTION_WORKER_ID=local-worker-1
INGESTION_LEASE_SECONDS=120
INGESTION_POLL_SECONDS=1

# Optional hosted wake-up adapter (local PostgreSQL polling remains the default)
JOB_DISPATCHER=local
# QSTASH_TOKEN=
# QSTASH_CALLBACK_URL=https://example.com/internal/qstash/dispatch
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Bounded local audio acquisition (used only after caption fallback is activated)
MEDIA_WORKSPACE_ROOT=tmp/media
MEDIA_MAX_DURATION_SECONDS=7200
MEDIA_MAX_DOWNLOAD_BYTES=268435456
MEDIA_MAX_OUTPUT_BYTES=268435456
MEDIA_TIMEOUT_SECONDS=600
MEDIA_MAX_CONCURRENCY=1
MEDIA_RETAIN_ON_SUCCESS=false
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
YT_DLP_JS_RUNTIME=node

# Local Phase 2 multilingual ASR (install provider dependencies and model weights manually)
ASR_PROVIDER=faster-whisper
ASR_MODEL=small
ASR_MODEL_REVISION=536b0662742c02347bc0e980a01041f333bce120
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=int8_float16
ASR_MAX_CONCURRENCY=1
