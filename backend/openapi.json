{
  "components": {
    "schemas": {
      "AnswerResponse": {
        "description": "Evidence-grounded answer contract.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Confidence",
            "type": "string"
          },
          "degraded_mode": {
            "title": "Degraded Mode",
            "type": "boolean"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceResponse"
            },
            "title": "Evidence",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "confidence",
          "evidence",
          "warnings",
          "degraded_mode"
        ],
        "title": "AnswerResponse",
        "type": "object"
      },
      "ErrorPayload": {
        "description": "Stable, human-safe API error information.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "suggested_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Action"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id",
          "retryable"
        ],
        "title": "ErrorPayload",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Top-level error envelope shared by every API failure.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorPayload"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidenceResponse": {
        "description": "One validated transcript citation returned with an answer.",
        "properties": {
          "cue_ids": {
            "items": {
              "type": "string"
            },
            "title": "Cue Ids",
            "type": "array"
          },
          "end_ms": {
            "exclusiveMinimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "modality": {
            "const": "transcript",
            "default": "transcript",
            "title": "Modality",
            "type": "string"
          },
          "quote": {
            "title": "Quote",
            "type": "string"
          },
          "retrieval_unit_id": {
            "title": "Retrieval Unit Id",
            "type": "string"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "video_id": {
            "format": "uuid",
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "retrieval_unit_id",
          "cue_ids",
          "quote",
          "start_ms",
          "end_ms"
        ],
        "title": "EvidenceResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Liveness response independent of external dependencies.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportVideoRequest": {
        "description": "A caller-supplied video locator accepted by the source registry.",
        "properties": {
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "source_url"
        ],
        "title": "ImportVideoRequest",
        "type": "object"
      },
      "ImportVideoResponse": {
        "description": "Prompt durable-import acknowledgement with idempotent job reuse.",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/IngestionJobResponse"
          },
          "reused": {
            "title": "Reused",
            "type": "boolean"
          }
        },
        "required": [
          "job",
          "reused"
        ],
        "title": "ImportVideoResponse",
        "type": "object"
      },
      "IngestionEventResponse": {
        "description": "One append-only event with its durable order, stage, attempt, and safe details.",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "$ref": "#/components/schemas/IngestionEventType"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryable"
          },
          "sequence": {
            "title": "Sequence",
            "type": "integer"
          },
          "stage": {
            "$ref": "#/components/schemas/IngestionStage"
          }
        },
        "required": [
          "event_id",
          "job_id",
          "sequence",
          "event_type",
          "stage",
          "attempt",
          "occurred_at"
        ],
        "title": "IngestionEventResponse",
        "type": "object"
      },
      "IngestionEventType": {
        "description": "Append-only facts emitted while a durable job advances.",
        "enum": [
          "created",
          "claimed",
          "heartbeat",
          "stage_started",
          "stage_completed",
          "retry_requested",
          "cancel_requested",
          "cancelled",
          "failed",
          "completed"
        ],
        "title": "IngestionEventType",
        "type": "string"
      },
      "IngestionEventsResponse": {
        "description": "Ordered event history scoped to one durable ingestion job.",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/IngestionEventResponse"
            },
            "title": "Events",
            "type": "array"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "events"
        ],
        "title": "IngestionEventsResponse",
        "type": "object"
      },
      "IngestionJobResponse": {
        "description": "Current durable job projection with source identity and lifecycle timestamps.",
        "properties": {
          "attempt": {
            "title": "Attempt",
            "type": "integer"
          },
          "cancel_requested_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancel Requested At"
          },
          "canonical_url": {
            "title": "Canonical Url",
            "type": "string"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "external_id": {
            "title": "External Id",
            "type": "string"
          },
          "input_fingerprint": {
            "title": "Input Fingerprint",
            "type": "string"
          },
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "last_error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error Code"
          },
          "last_error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error Message"
          },
          "last_error_retryable": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error Retryable"
          },
          "source_kind": {
            "$ref": "#/components/schemas/VideoSourceKind"
          },
          "stage": {
            "$ref": "#/components/schemas/IngestionStage"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/IngestionJobStatus"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "video_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Video Id"
          }
        },
        "required": [
          "job_id",
          "source_kind",
          "external_id",
          "canonical_url",
          "input_fingerprint",
          "status",
          "stage",
          "attempt",
          "created_at",
          "updated_at"
        ],
        "title": "IngestionJobResponse",
        "type": "object"
      },
      "IngestionJobStatus": {
        "description": "Persisted lifecycle state for one logical ingestion request.",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "IngestionJobStatus",
        "type": "string"
      },
      "IngestionStage": {
        "description": "Phase 2 stages in execution order, excluding later multimodal capabilities.",
        "enum": [
          "source_resolution",
          "metadata",
          "caption_retrieval",
          "audio_acquisition",
          "transcription",
          "chunking",
          "persistence",
          "embedding",
          "indexing",
          "cleanup",
          "completed"
        ],
        "title": "IngestionStage",
        "type": "string"
      },
      "JsonValue": {},
      "QuestionRequest": {
        "description": "A non-empty transcript question.",
        "properties": {
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "QuestionRequest",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness response returned after all required dependencies respond.",
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "const": "ready",
              "type": "string"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RetrievalUnitResponse": {
        "description": "One retrieval interval with ordered cue provenance.",
        "properties": {
          "cue_ids": {
            "items": {
              "type": "string"
            },
            "title": "Cue Ids",
            "type": "array"
          },
          "end_ms": {
            "exclusiveMinimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "retrieval_unit_id": {
            "title": "Retrieval Unit Id",
            "type": "string"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "retrieval_unit_id",
          "start_ms",
          "end_ms",
          "text",
          "cue_ids"
        ],
        "title": "RetrievalUnitResponse",
        "type": "object"
      },
      "TranscriptCueResponse": {
        "description": "One exact normalized caption cue.",
        "properties": {
          "caption_kind": {
            "enum": [
              "manual",
              "automatic"
            ],
            "title": "Caption Kind",
            "type": "string"
          },
          "cue_id": {
            "title": "Cue Id",
            "type": "string"
          },
          "end_ms": {
            "exclusiveMinimum": 0.0,
            "title": "End Ms",
            "type": "integer"
          },
          "language_code": {
            "title": "Language Code",
            "type": "string"
          },
          "source_order": {
            "minimum": 0.0,
            "title": "Source Order",
            "type": "integer"
          },
          "start_ms": {
            "minimum": 0.0,
            "title": "Start Ms",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "cue_id",
          "source_order",
          "start_ms",
          "end_ms",
          "text",
          "language_code",
          "caption_kind"
        ],
        "title": "TranscriptCueResponse",
        "type": "object"
      },
      "TranscriptResponse": {
        "description": "Complete transcript projection used by the Phase 1 UI.",
        "properties": {
          "cues": {
            "items": {
              "$ref": "#/components/schemas/TranscriptCueResponse"
            },
            "title": "Cues",
            "type": "array"
          },
          "retrieval_units": {
            "items": {
              "$ref": "#/components/schemas/RetrievalUnitResponse"
            },
            "title": "Retrieval Units",
            "type": "array"
          },
          "video": {
            "$ref": "#/components/schemas/VideoResponse"
          }
        },
        "required": [
          "video",
          "cues",
          "retrieval_units"
        ],
        "title": "TranscriptResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VideoResponse": {
        "description": "Safe canonical metadata returned by import and detail endpoints.",
        "properties": {
          "canonical_url": {
            "title": "Canonical Url",
            "type": "string"
          },
          "channel_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel Name"
          },
          "duration_ms": {
            "exclusiveMinimum": 0.0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "external_id": {
            "title": "External Id",
            "type": "string"
          },
          "index_ready": {
            "title": "Index Ready",
            "type": "boolean"
          },
          "source_kind": {
            "title": "Source Kind",
            "type": "string"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "transcript_ready": {
            "default": true,
            "title": "Transcript Ready",
            "type": "boolean"
          },
          "video_id": {
            "format": "uuid",
            "title": "Video Id",
            "type": "string"
          }
        },
        "required": [
          "video_id",
          "source_kind",
          "external_id",
          "canonical_url",
          "title",
          "duration_ms",
          "index_ready"
        ],
        "title": "VideoResponse",
        "type": "object"
      },
      "VideoSourceKind": {
        "description": "Supported source families for the transcript-first slice.",
        "enum": [
          "youtube",
          "local_file"
        ],
        "title": "VideoSourceKind",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Galaxy Frog API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Report process liveness without consulting external dependencies.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report readiness only after PostgreSQL responds to a real query.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "description": "Return the current durable projection for one ingestion job.",
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Job",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "description": "Persist a cancellation request or immediately cancel queued work.",
        "operationId": "cancel_job_v1_jobs__job_id__cancel_post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionJobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Cancel Job",
        "tags": [
          "ingestion"
        ]
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "description": "Return append-only job events in their persisted sequence order.",
        "operationId": "get_job_events_v1_jobs__job_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionEventsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
