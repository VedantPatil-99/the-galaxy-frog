{
  "name": "galaxy-frog",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "sync": "bun run --sequential sync:web sync:backend",
    "sync:web": "bun install --frozen-lockfile",
    "sync:backend": "uv sync --directory backend --locked",
    "dev": "bun run --parallel dev:web dev:api dev:worker",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "PYTHONUTF8=1 uv run --directory backend fastapi dev",
    "dev:worker": "PYTHONUTF8=1 uv run --directory backend python -m galaxy_frog.entrypoints.worker",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres",
    "db:migrate": "uv run --directory backend alembic upgrade head",
    "openapi:generate": "uv run --directory backend python -m galaxy_frog.openapi",
    "openapi:check": "uv run --directory backend python -m galaxy_frog.openapi --check",
    "api:generate": "bun run --cwd apps/web api:generate",
    "api:check": "bun run --cwd apps/web api:check",
    "contracts:generate": "bun run --sequential openapi:generate api:generate",
    "contracts:check": "bun run --sequential openapi:check api:check",
    "lint": "bun run --parallel lint:web lint:backend",
    "lint:web": "bun run --cwd apps/web lint",
    "lint:backend": "uv run --directory backend ruff check .",
    "format:check": "uv run --directory backend ruff format --check .",
    "typecheck": "bun run --parallel typecheck:web typecheck:backend",
    "typecheck:web": "bun run --cwd apps/web typecheck",
    "typecheck:backend": "uv run --directory backend python -m pyright",
    "test": "bun run --parallel test:web test:backend",
    "test:web": "bun run --cwd apps/web test",
    "test:backend": "uv run --directory backend pytest",
    "build": "bun run --cwd apps/web build",
    "smoke": "bash scripts/smoke-test.sh",
    "smoke:phase1": "bun scripts/phase-1-smoke.ts",
    "smoke:phase2": "bun scripts/phase-2-smoke.ts",
    "check": "bun run --sequential contracts:check lint format:check typecheck test build",
    "precommit": "uv run --directory backend pre-commit run --all-files"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
